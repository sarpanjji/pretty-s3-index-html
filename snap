body {
    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: #f8f9fa;
    margin: 0;
}

.login-container {
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    width: 300px;
    text-align: center;
}

h2 {
    margin-bottom: 20px;
}

label {
    display: block;
    text-align: left;
    font-size: 12px;
    color: #3498db;
    font-weight: bold;
    margin-top: 10px;
}

input[type="text"], input[type="password"] {
    width: 100%;
    padding: 8px;
    margin-top: 5px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 14px;
}

.phone-option {
    font-size: 12px;
    color: #3498db;
    margin: 5px 0;
    cursor: pointer;
}

.password-container {
    position: relative;
}

.eye-icon {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
    font-size: 14px;
}

.remember-me {
    display: flex;
    align-items: center;
    font-size: 12px;
    margin-top: 10px;
    color: #666;
}

.forgot-password {
    display: block;
    font-size: 12px;
    color: #3498db;
    margin-top: 10px;
}

.login-btn {
    width: 100%;
    padding: 10px;
    background-color: lightgray;
    border: none;
    border-radius: 5px;
    color: white;
    margin-top: 20px;
    cursor: not-allowed;
}
